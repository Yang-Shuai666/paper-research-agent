DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Optional: relative paths are resolved against the project root
EMBEDDING_MODEL_PATH=models/bge-m3
# auto picks the GPU with the most free memory; use cuda:1 or cpu to pin
EMBEDDING_DEVICE=auto
# Cap this process to 15% of the selected GPU, friendly to shared servers
EMBEDDING_GPU_MEMORY_FRACTION=0.15

# Section-aware chunking (characters)
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# dense or hybrid (dense + BM25 with weighted reciprocal rank fusion)
RETRIEVAL_MODE=hybrid
DENSE_CANDIDATES=20
BM25_CANDIDATES=20
RRF_K=20
DENSE_WEIGHT=1.0
SPARSE_WEIGHT=0.25

# Rewrite Chinese queries to English before retrieval (cached on disk)
ENABLE_QUERY_REWRITE=true
QUERY_REWRITE_CACHE_PATH=data/cache/query_rewrites.json

# Cross-encoder reranking of the retrieved candidates
ENABLE_RERANK=true
RERANKER_MODEL_PATH=models/bge-reranker-v2-m3
RERANK_CANDIDATES=12
RERANK_BATCH_SIZE=8

# Expand top chunks with same-page neighbors before answering
ENABLE_CONTEXT_EXPANSION=true
CONTEXT_EXPANSION_WINDOW=2
CONTEXT_EXPANSION_MAX_CHUNKS=16
